{
  "version": "3.1",
  "data_api_version": "3.0",
  "routing_model": {
    "CATEGORIES": ["PRODUCTS"],
    "PRODUCTS": []
  },
  "screens": [
    {
      "id": "CATEGORIES",
      "title": "Categorías",
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "Platos", "title": "Platos" },
            { "id": "Bebidas", "title": "Bebidas" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¿Qué categoría te provoca?"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "category",
            "label": "Categorías",
            "data-source": "${data.categories}",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Continuar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "category": "${form.category}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PRODUCTS",
      "title": "Productos",
      "data": {
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "Bandeja paisa" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Elige un producto"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "product",
            "label": "Productos",
            "data-source": "${data.products}",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Confirmar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "product": "${form.product}"
              }
            }
          }
        ]
      }
    }
  ]
}
